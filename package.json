{
  "name": "@qcksys/ao3tracker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "vp run --filter @qcksys/ao3tracker-api test:e2e",
    "ready": "vp fmt && vp lint && vp run -r test && vp run -r build",
    "dev": "vp run --filter @qcksys/ao3tracker-api dev",
    "version-packages": "vp exec changeset version && vp install --lockfile-only --ignore-scripts --no-frozen-lockfile && vp fmt",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@changesets/get-release-plan": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.8.2"
}
