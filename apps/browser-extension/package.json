{
  "name": "@qcksys/ao3tracker-browser-extension",
  "version": "0.0.1",
  "private": true,
  "description": "AO3 Tracker browser extension (Chrome/Firefox, Manifest V3 via WXT).",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vp test run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@qcksys/ao3tracker-core": "workspace:*",
    "@qcksys/ao3tracker-sync-client": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@wxt-dev/storage": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-router": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/chrome": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@wxt-dev/module-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
