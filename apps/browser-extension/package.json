    "@qcksys/ao3tracker-sync-client": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@wxt-dev/storage": "^1.2.8",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next-themes": "catalog:",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-router": "^7.15.0",
    "sonner": "catalog:",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.42",
