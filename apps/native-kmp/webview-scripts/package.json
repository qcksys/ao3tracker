{
    "name": "ao3tracker-webview-scripts",
    "version": "1.0.0",
    "private": true,
    "description": "WebView scripts for AO3 Tracker",
    "scripts": {
        "build": "bun run build.ts",
        "build:dev": "bun run build.ts --dev",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "biome:check:unsafe": "biome check --write --unsafe",
        "biome:ci": "biome ci"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.10",
        "happy-dom": "^20.0.11",
        "typescript": "^5.9.3",
        "vitest": "^4.0.16"
    }
}
