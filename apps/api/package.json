{
    "name": "@qcksys/ao3tracker-api",
    "type": "module",
    "scripts": {
        "test": "vitest",
        "dev": "wrangler dev",
        "proxy": "cloudflared tunnel --config dev/cloudflared/cloudflared.dev.yml run",
        "deploy:dev": "wrangler deploy --minify -e dev",
        "deploy:prod": "wrangler deploy --minify -e prod",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "types:cf": "wrangler types --env-interface CloudflareBindings",
        "types:tsc": "tsc",
        "biome:check:unsafe": "biome check --write --unsafe",
        "biome:ci": "biome ci",
        "better-auth-gen-schema": "pnpm dlx @better-auth/cli@latest generate --config ./better-auth.config.ts --output ./src/db/schema/.temp.auth.ts",
        "prepare": "husky",
        "precommit": "pnpm run biome:ci && pnpm types:cf && pnpm run types:tsc"
    },
    "dependencies": {
        "@better-auth/passkey": "^1.4.9",
        "@hono/zod-openapi": "^1.2.0",
        "@planetscale/database": "^1.19.0",
        "@qcksys/drizzle-extensions": "^0.2.0",
        "@scalar/hono-api-reference": "^0.9.30",
        "@scalar/openapi-to-markdown": "^0.3.12",
        "better-auth": "^1.4.9",
        "date-fns": "^4.1.0",
        "drizzle-orm": "^0.45.1",
        "drizzle-zod": "^0.8.3",
        "hono": "^4.11.3",
        "jose": "^6.1.3",
        "ky": "^1.14.2",
        "mailersend": "^2.6.0",
        "zod": "^4.3.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.6",
        "@cloudflare/vitest-pool-workers": "^0.11.1",
        "@types/node": "^24.10.4",
        "dotenv": "^17.2.3",
        "drizzle-kit": "^0.31.8",
        "husky": "^9.1.7",
        "typescript": "^5.9.3",
        "vite-tsconfig-paths": "^6.0.3",
        "vitest": "~3.2.4",
        "wrangler": "^4.54.0"
    },
    "volta": {
        "node": "24.11.1"
    },
    "packageManager": "pnpm@10.27.0"
}
