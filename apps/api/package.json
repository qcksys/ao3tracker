{
  "name": "@qcksys/ao3tracker-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vp test run --config vitest.config.ts",
    "build": "vp build",
    "preview": "vp preview",
    "dev": "portless ao3tracker --app-port 5173 vp dev",
    "proxy": "cloudflared tunnel --config dev/cloudflared/cloudflared.dev.yml run",
    "deploy:dev": "vp build --mode dev && wrangler deploy --config dist/ssr/wrangler.json",
    "deploy:prod": "vp build --mode prod && wrangler deploy --config dist/ssr/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "types:cf": "wrangler types --env-interface CloudflareBindings",
    "types:tsc": "tsc",
    "biome:check:unsafe": "biome check --write --unsafe",
    "biome:ci": "biome ci",
    "better-auth-gen-schema": "pnpm dlx @better-auth/cli@latest generate --config ./better-auth.config.ts --output ./src/db/schema/.temp.auth.ts",
    "precommit": "pnpm run biome:ci && pnpm types:cf && pnpm run types:tsc"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@planetscale/database": "catalog:",
    "@qcksys/drizzle-extensions": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "@scalar/openapi-to-markdown": "catalog:",
    "better-auth": "catalog:",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "ky": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "portless": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "volta": {
    "node": "24.11.1"
  }
}
