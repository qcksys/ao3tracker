{
    "name": "@qcksys/ao3tracker-api",
    "type": "module",
    "scripts": {
        "test": "vitest",
        "dev": "wrangler dev",
        "proxy": "cloudflared tunnel --config dev/cloudflared/cloudflared.dev.yml run",
        "deploy:dev": "wrangler deploy --minify -e dev",
        "deploy:prod": "wrangler deploy --minify -e prod",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "types:cf": "wrangler types --env-interface CloudflareBindings",
        "types:tsc": "tsc",
        "biome:check:unsafe": "biome check --write --unsafe",
        "biome:ci": "biome ci",
        "better-auth-gen-schema": "pnpm dlx @better-auth/cli@latest generate --config ./better-auth.config.ts --output ./src/db/schema/.temp.auth.ts",
        "precommit": "pnpm run biome:ci && pnpm types:cf && pnpm run types:tsc"
    },
    "dependencies": {
        "@better-auth/passkey": "^1.6.11",
        "@hono/zod-openapi": "^1.4.0",
        "@planetscale/database": "^1.20.1",
        "@qcksys/drizzle-extensions": "^0.2.0",
        "@scalar/hono-api-reference": "^0.9.48",
        "@scalar/openapi-to-markdown": "^0.3.56",
        "better-auth": "^1.6.11",
        "date-fns": "^4.1.0",
        "drizzle-orm": "^0.45.2",
        "drizzle-zod": "^0.8.3",
        "hono": "^4.12.18",
        "jose": "^6.2.3",
        "ky": "^1.14.3",
        "mailersend": "^2.8.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.6",
        "@cloudflare/vitest-pool-workers": "^0.11.1",
        "@types/node": "^24.12.4",
        "dotenv": "^17.4.2",
        "drizzle-kit": "^0.31.10",
        "typescript": "catalog:",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "catalog:",
        "wrangler": "^4.90.1"
    },
    "volta": {
        "node": "24.11.1"
    },
    "packageManager": "pnpm@10.27.0"
}
