{
  "include": ["src/**/*", "test/**/*", "*"],
  "exclude": ["test/e2e"],
  "compilerOptions": {
    "types": ["vite/client"],
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ESNext"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "~/*": ["./src/*"],
      "~test/*": ["./test/*"]
    }
  }
}
