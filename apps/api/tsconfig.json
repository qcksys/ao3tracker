{
    "include": ["src/**/*", "test/**/*", "*"],
    "compilerOptions": {
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noEmit": true,
        "composite": true,
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "lib": ["ESNext"],
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "paths": {
            "~/*": ["./src/*"],
            "~test/*": ["./test/*"]
        }
    }
}
