# Copy this file to .dev.vars and fill in the values before running the development environment
# Example: cp .dev.vars.example .dev.vars

# Database connection URL
DATABASE_URL=

#  BetterAuth secret for authentication
BETTER_AUTH_SECRET=

# For Google OAuth2 authentication
GOOGLE_ID=
GOOGLE_SECRET=

# Firebase Cloud Messaging service account JSON (for push notifications)
# Get this from Firebase Console > Project Settings > Service Accounts > Generate new private key
FCM_SERVICE_ACCOUNT=
