{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "923e3a86a572d6d6d05230ccadbbbe34",
  "main": "src/index.tsx",
  "compatibility_date": "2025-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "region": "aws:ap-southeast-2"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "preview_urls": false,
  "workers_dev": false,
  "secrets": {
    "required": [
      "DATABASE_URL",
      "BETTER_AUTH_SECRET",
      "GOOGLE_ID",
      "GOOGLE_SECRET",
      "FCM_SERVICE_ACCOUNT"
    ]
  },
  "r2_buckets": [
    {
      "binding": "WORK_BACKUPS_BUCKET",
      "bucket_name": "ao3tracker-work-backups-dev",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "AO3_PROXY_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
      "allowed_sender_addresses": ["hello@dev.ao3tracker.com"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "ao3tracker-notifications-dev",
        "remote": false
      }
    ],
    "consumers": [
      {
        "queue": "ao3tracker-notifications-dev",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "ao3tracker-notifications-dlq-dev"
      }
    ]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://qcksys-ao3tracker-api-local.ta2.dev",
    "ENVIRONMENT": "local",
    "SYSTEM_EMAIL_ADDRESS": "hello@dev.ao3tracker.com",
